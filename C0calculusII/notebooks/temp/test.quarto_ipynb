      "source": [
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "## Using numpy\n",
        "from numpy import sin, cos, tan\n",
        "\n",
        "t = [0, 12]\n",
        "t = np.linspace(t[0],t[1],1000)\n",
        "\n",
        "x = t* np.sin(np.pi*t/2)\n",
        "y = t* np.cos(np.pi*t/2) \n",
        "\n",
        "pd.DataFrame([t,x,y]).T\n",
        "\n",
        "plt.plot(x,y)\n",
        "plt.gca().set_aspect('equal')"
      ],
      "id": "8ece29f1",
