        "theta = np.linspace(0, 2 * np.pi, 100)\n",
        "z = 0\n",
        "r = 1\n",
        "x = r * np.sin(theta)\n",
        "y = r * np.cos(theta)\n",
        "ax.plot(x, y, z)\n",
        "\n",
        "## We can shift the same plot by choosing different values of z.\n",
        "# z = 3\n",
        "# ax.plot(x, y, z)\n",
        "\n",
        "## for z in np.linspace(0, 1, 100):\n",
