{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: Parametric Curves and Polar Coordinates\n",
        "---\n"
      ],
      "id": "582ec30f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| code-summary: Some plotting routines. Click to expand\n",
        "import numpy as np\n",
        "import sympy as sp\n",
        "import matplotlib.pyplot as plt\n",
        "from sympy import plot_parametric, symbols\n",
        "from IPython.display import display, Markdown\n",
        "from functools import partial\n",
        "\n",
        "## This is a 'partial function' so that we don't have to set figure size and aspect ratio every time.\n",
        "splot = partial(plot_parametric, aspect_ratio = (1,1),size=(4,4),axis_center = (0,0))\n",
        "\n",
        "\n",
        "def _displayM(text, expr):\n",
        "  \"\"\"\n",
        "  Display text and expression inline. \n",
        "  \"\"\"\n",
        "  display(Markdown('{} {}'.format(\n",
        "            text,\n",
        "            sp.latex(expr, mode='inline')\n",
        "          ))\n",
        "  )"
      ],
      "id": "7a372117",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Example (r = 1 - cos(t))"
      ],
      "id": "cd8d1328"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# x, y = sp.symbols('x y')\n",
        "r, t = sp.symbols('r t')\n",
        "\n",
        "r = 1 - sp.cos(t)\n",
        "\n",
        "x = r * sp.cos(t)\n",
        "y = r * sp.sin(t)\n",
        "splot((x,y), (t, 0, 2 * sp.pi))\n"
      ],
      "id": "1fc99506",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Example ($r^2 = 4 cos(t))"
      ],
      "id": "b2c2b807"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## NUMPY\n",
        "## -----\n",
        "# Define the parameter\n",
        "t = np.linspace(0, 2 * np.pi, 1000)\n",
        "\n",
        "# Compute r from the parametrization\n",
        "r = np.sqrt(4* np.cos(t))\n",
        "\n",
        "# Compute x and y for the two lobes\n",
        "x1 = r * np.cos(t)\n",
        "y1 = r * np.sin(t)\n",
        "\n",
        "x2 = -r * np.cos(t)\n",
        "y2 = -r * np.sin(t)\n",
        "\n",
        "# Plot using Matplotlib\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.plot(x1, y1)\n",
        "plt.plot(x2, y2)\n",
        "\n",
        "plt.axhline(0, color='black',linewidth=0.5)\n",
        "plt.axvline(0, color='black',linewidth=0.5)\n",
        "plt.grid(True, which='both')\n",
        "plt.gca().set_aspect('equal', adjustable='box')\n",
        "plt.show()"
      ],
      "id": "c03d76d4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## SYMPY\n",
        "##-------\n",
        "r, t = sp.symbols('r t', positive = False)\n",
        "\n",
        "r_sq = 4 * sp.cos(t)\n",
        "r_lobes = [sp.sqrt(r_sq), -sp.sqrt(r_sq)]\n",
        "\n",
        "## Find x and y\n",
        "x_lobes = [lobe * sp.cos(t) for lobe in r_lobes]\n",
        "y_lobes = [lobe * sp.sin(t) for lobe in r_lobes]\n",
        "\n",
        "splot((x_lobes[0],y_lobes[0], (t, - sp.pi/2, sp.pi/2)),\n",
        "      (x_lobes[1],y_lobes[1], (t, - sp.pi/2, sp.pi/2))\n",
        ")\n"
      ],
      "id": "98eb6b88",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Areas in Polar Coordinates\n",
        "\n",
        "\n",
        "### Of cardioid ($r = 2(1+cos(\\theta))$)\n"
      ],
      "id": "2ae85cba"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Total area\n",
        "\n",
        "r, t = sp.symbols('r t')\n",
        "\n",
        "r = 2 * (1 + sp.cos(t))\n",
        "\n",
        "sp.integrate(1/2 * r**2, (t, 0, 2 * sp.pi))"
      ],
      "id": "42c5680c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Area between curves"
      ],
      "id": "25aa0927"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Area between regions \n",
        "\n",
        "##-- Define curves\n",
        "r1, r2, t = sp.symbols('r1 r2 t')\n",
        "\n",
        "r1 = 1 - sp.cos(t)\n",
        "r2 = 1\n",
        "\n",
        "##-- Find Area\n",
        "\n",
        "res = sp.integrate((r2**2 - r1**2)/2, (t, -sp.pi/2, sp.pi/2))\n",
        "_displayM(\"Area between curves is:\", res)\n",
        "\n",
        "\n",
        "##-- Plot curves\n",
        "x1 = r1 * sp.cos(t)\n",
        "y1 = r1 * sp.sin(t)\n",
        "\n",
        "x2 = r2 * sp.cos(t)\n",
        "y2 = r2 * sp.sin(t)\n",
        "\n",
        "splot((x1,y1, (t, -sp.pi/2, sp.pi/2)),\n",
        "      (x2,y2, (t, -sp.pi/2, sp.pi/2))\n",
        ")\n"
      ],
      "id": "9c4b74f2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Intersecting curves"
      ],
      "id": "a892dbc5"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "r1, r2, t = sp.symbols('r1 r2 t')\n",
        "\n",
        "r1 = 2 * sp.cos(t/3)\n",
        "r2 = sp.sqrt(2)\n",
        "\n",
        "## Find intersects to r1 == r2.\n",
        "res = sp.solve(r1 - r2, t, dict = True)\n",
        "\n",
        "res\n",
        "## Display neatly\n",
        "# [_displayM(f\"Solution {idx}: \", i[t]) for idx, i in enumerate(res)];"
      ],
      "id": "aff659cd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "x = [r * sp.cos(t) for r in (r1, r2)]\n",
        "y = [r * sp.sin(t) for r in (r1, r2)]\n",
        "\n",
        "splot(x[1], y[1], (t, 0, 2 * sp.pi))\n",
        "\n",
        "splot((x[1], y[1], (t, 0, 2 * sp.pi)),\n",
        "(x[0], y[0], (t, 0, 4 * sp.pi))\n",
        "\n",
        ")"
      ],
      "id": "11c95b6e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Lengths in Polar Coordinates\n",
        "\n",
        "### Length of cardioid ($r= 1 - cos(\\theta)$)"
      ],
      "id": "54a87240"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Total area\n",
        "\n",
        "from sympy.simplify.fu import TR11, TR0\n",
        "\n",
        "\n",
        "r, t = sp.symbols('r t', real = True)\n",
        "\n",
        "r = (1 - sp.cos(t))\n",
        "drdt = sp.diff(r,t)\n",
        "\n",
        "\n",
        "f = sp.sqrt(r**2 + drdt**2)\n",
        "integrand = sp.simplify(f)\n",
        "# integrand = integrand.subs(sp.sqrt(1-sp.cos(t)), sp.sin(t/2)*2)\n",
        "integrand\n",
        "# sp.integrate(integrand, (t, 0, 2 * sp.pi))"
      ],
      "id": "b490343b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from sympy.simplify.fu import TR11, TR0\n",
        "from sympy import cos, sin, pi\n",
        "from sympy.abc import x\n",
        "TR0(TR11(integrand, base = t*2))"
      ],
      "id": "c3079ac4",
      "execution_count": null,
      "outputs": []
    }
  ],
