  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: Parametric Plots\n",
        "---\n",
        "\n",
        "::::{.ddm}\n",
        ":::{.ddm-head onclick=\"toggleBox(this)\"}\n",
        "\n",
        "### Basic parametrizations\n",
        "\n",
        ":::\n",
        ":::{.ddm-box}"
      ],
      "id": "26ccec40"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| code-summary: Some plotting routines. Click to expand\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def plotter(x, y, create = False):\n",
        "    if create: plt.figure(figsize=(6, 6))\n",
        "    plt.plot(x, y)\n",
        "    plt.gca().set_aspect('equal', adjustable='box')\n",
        "\n",
        "    return\n",
        "\n",
        "def centeraxes():\n",
        "    ax = plt.gca()\n",
        "    # Move left y-axis and bottom x-axis to centre, passing through (0,0)\n",
        "\n",
        "    ax.spines['left'].set_position('zero')\n",
        "    ax.spines['bottom'].set_position('zero')\n",
        "\n",
        "    # Eliminate upper and right axes\n",
        "    ax.spines['right'].set_color('none')\n",
        "    ax.spines['top'].set_color('none')\n",
        "\n",
        "    # Show ticks in the left and lower axes only\n",
        "    ax.xaxis.set_ticks_position('bottom')\n",
        "    ax.yaxis.set_ticks_position('left')\n",
        "    return"
      ],
      "id": "e54fdd8d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Parabola\n",
        "\n",
        "### Circle and Ellipse"
      ],
      "id": "c1633873"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "t = np.linspace(0, 2 * np.pi, 400)\n",
        "\n",
        "x = np.cos(t)\n",
        "y = np.sin(t)\n",
        "plotter(x,y, create = True)\n",
        "\n",
        "x = 2* np.cos(t)\n",
        "y = np.sin(t)\n",
        "plotter(x,y)\n",
        "centeraxes()\n",
        "plt.show()"
      ],
      "id": "98740246",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Hyperpola"
      ],
      "id": "9e9e5770"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "t = np.linspace(0.1, 10, 400)\n",
        "\n",
        "x = t + 1/t\n",
        "y = t - 1/t\n",
        "plotter(x,y)\n",
        "centeraxes()\n",
        "\n",
        "plt.show()"
      ],
      "id": "876cf85b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Cycloid"
      ],
      "id": "199712f2"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "t = np.linspace(0, 8*np.pi, 400)\n",
        "\n",
        "a = 1\n",
        "\n",
        "x = a * (t - np.sin(t))\n",
        "y = a * (1 - np.cos(t))\n",
        "plotter(x,y)\n",
        "centeraxes()\n",
        "\n",
        "plt.show()"
      ],
      "id": "22915dc5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Brachistochrone and Tautochrone\n",
        "\n",
        "\n",
        ":::\n",
        "::::\n",
        "\n",
        "\n",
        "\n",
        "::::{.ddm}\n",
        ":::{.ddm-head onclick=\"toggleBox(this)\"}\n",
        "\n",
        "### Miscellaneous \n",
        "\n",
        ":::\n",
        ":::{.ddm-box}\n",
        "\n",
        "Drawing the Batman curve."
      ],
      "id": "630e3e18"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| code-summary: \"Non-parametric version\"\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "x = np.linspace(-6,6,1000)\n",
        "\n",
        "def sf(x):\n",
        "    return np.sqrt(1-x**2)                           # semicircle\n",
        "def ef(x):\n",
        "    return 3*sf(x/7)                             # ellipse\n",
        "def sh(x):\n",
        "    return 4.2 - .5*x -2.8*sf(.5*x -.5)          # shoulders\n",
        "def bf(x):\n",
        "    return sf(abs(2 - x) - 1) - x**2/11 + .5*x -3 # bottom\n",
        "\n",
        "cl_x = [0,0.5,0.8,1]\n",
        "cl_xn = [-x for x in cl_x]\n",
        "cl_y = [1.7, 1.7, 2.6, 0.9]\n",
        "\n",
        "def p(f,xmin,xmax, flipy = False):\n",
        "    \"symmetric plot across y-axis\"\n",
        "    \n",
        "    x = np.linspace(xmin, xmax, 100)\n",
        "    y = f(x)\n",
        "    if flipy: \n",
        "        y = -y\n",
        "    p1 = plt.plot(x, y)\n",
        "    \n",
        "    x = [-i for i in x]\n",
        "    ax = plt.plot(x, y)\n",
        "    \n",
        "    return ax\n",
        "\n",
        "p(ef,3,7) \n",
        "p(ef,4,7, flipy = True) \n",
        "p(sh,1,3)\n",
        "p(bf,0,4) \n",
        "plt.plot(cl_x, cl_y)\n",
        "plt.plot(cl_xn, cl_y)\n",
        "plt.show()"
      ],
      "id": "636d31a3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Below is a parametrized version of the plot."
      ],
      "id": "eae4bdfa"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| code-summary: \"Parametric version\"\n",
        "#| \n",
        "import sympy as sm\n",
        "\n",
        "\n",
        "x = sm.symbols('x', real=True)\n",
        "h_ = sm.symbols('h_')\n",
        "\n",
        "w = 3 * sm.sqrt(1 - (x / 7)**2)\n",
        "l = ((x + 3) / 2 - sm.S(3) / 7 * sm.sqrt(10) * sm.sqrt(4 - (x + 1)**2) +\n",
        "        sm.S(6) / 7 * sm.sqrt(10))\n",
        "r = ((3 - x) / 2 - sm.S(3) / 7 * sm.sqrt(10) * sm.sqrt(4 - (x - 1)**2) +\n",
        "        sm.S(6) / 7 * sm.sqrt(10))\n",
        "h = (3*(sm.Abs(x - sm.S.Half) + sm.Abs(x + sm.S.Half) + 6) -\n",
        "                11*(sm.Abs(x - sm.S(3)/4) + sm.Abs(x + sm.S(3)/4)))/2 \n",
        "f = ((h - l) * sm.Heaviside(x + 1, 0) +\n",
        "        (r - h) * sm.Heaviside(x - 1, 0) +\n",
        "        (l - w) * sm.Heaviside(x + 3, 0) +\n",
        "        (w - r) * sm.Heaviside(x - 3, 0) + \n",
        "        w)\n",
        "g = (sm.S(1) / 2 * (sm.Abs(x / 2) + sm.sqrt(1 - (sm.Abs(sm.Abs(x) - 2) -\n",
        "        1)**2) - sm.S(1) / 112 * (3 * sm.sqrt(33) - 7) * x**2 + 3 *\n",
        "        sm.sqrt(1 - (sm.S(1) / 7 * x)**2) - 3) * ((x + 4) / sm.Abs(x + 4) -\n",
        "        (x - 4) / sm.Abs(x - 4)) - 3 * sm.sqrt(1 - (x / 7)**2))\n",
        "sm.plot(f, g)"
      ],
      "id": "2f426655",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The bottom wings are missing. Most likely some part of the equation is missing. You can experiment with the equations if you want.\n",
        "\n",
        "![Taken from Math World](../figs/batman.png)\n",
        "\n",
        ":::\n",
        "::::\n"
      ],
      "id": "89a0f8c2"
    }
