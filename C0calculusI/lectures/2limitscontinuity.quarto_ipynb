{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: Limits and Continuity\n",
        "---"
      ],
      "id": "afba5c30"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-summary: Presets and Definitions\n",
        "\n",
        "\n",
        "import pandas as pd\n",
        "import sympy as sp\n",
        "\n",
        "marker = {\"color\": \"r\", \"marker\": \"s\", \"fillstyle\":'full',\"markerfacecolor\":'white', \"markersize\":10, \"linestyle\":'--'}"
      ],
      "id": "35f70e40",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Averages "
      ],
      "id": "b8a7e652"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "x = sp.symbols('x')\n",
        "\n",
        "y = 4.9 * x**2\n",
        "\n",
        "evalat = [1,2,3,4,5]\n",
        "result = [y.subs(x, i).evalf(3) for i in evalat]\n",
        "\n",
        "xypairs = list(zip(evalat, result))\n",
        "\n",
        "pd.DataFrame(xypairs, columns = ['x', 'y'])"
      ],
      "id": "92bbf55c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "x = sp.symbols('x')\n",
        "func = 4.9 * x**2\n",
        "\n",
        "evalat = [1, 3, 7]\n",
        "y = [func.subs(x, val) for val in evalat]\n",
        "\n",
        "marker['args'] = [evalat, y] #See presets at top\n",
        "\n",
        "sp.plot(func, (x,-1,7), \n",
        "markers = marker, \n",
        "annotations=[{'xy': (3, 120), 'text': \"Secant\", 'fontsize':15}]\n",
        ")"
      ],
      "id": "f4cc7311",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "We can also evaluate this numerically:\n",
        "\n",
        "\n",
        "\n",
        "## Limits\n",
        "\n",
        "### Of rational functions\n"
      ],
      "id": "12a20f7b"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Limits of rational functions\n",
        "\n",
        "x = sp.symbols('x')\n",
        "p = x**3 + 4*x**2 - 3\n",
        "q = x**2 + 5\n",
        "\n",
        "rp = p/q\n",
        "\n",
        "evalat = -1\n",
        "result = sp.limit(rp, x, evalat)\n",
        "\n",
        "# sp.plot(rp, (x, -2,0))\n",
        "marker['args'] = [evalat, result]\n",
        "\n",
        "sp.plot(rp, (x, -2,0), markers = marker)"
      ],
      "id": "7384ba80",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Example - Limit with denominator 0"
      ],
      "id": "cd1014c2"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sympy as sp\n",
        "x = sp.symbols('x')\n",
        "\n",
        "f = (sp.sqrt(x**2 + 100) - 10)/ x**2\n",
        "\n",
        "sp.plot(f, (x, -1 , 1))"
      ],
      "id": "0f8c5b45",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Sandwich theorem"
      ],
      "id": "3ee3b290"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sympy as sp\n",
        "x = sp.symbols('x')\n",
        "\n",
        "xi, xf = -1,1\n",
        "\n",
        "f = x**2 * sp.sin(1/x**2)\n",
        "upper = x**2\n",
        "lower = -x**2\n",
        "\n",
        "sp.plot(f, (x, xi , xf))\n",
        "\n",
        "sp.plot((f, (x, xi , xf)),\n",
        "        (upper, (x,xi, xf)),\n",
        "        (lower, (x, xi, xf))\n",
        ")\n"
      ],
      "id": "2af7c72c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### One-sided limits\n",
        "\n",
        "\n",
        "### Limits (Rigorous definition)\n",
        "\n",
        "### Limits involving infinity\n",
        "\n",
        "#### Oblique asymptotes\n"
      ],
      "id": "98b37d6e"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "x = sp.symbols('x')\n",
        "f = (x**3 - 8)/(x-4) \n",
        "\n",
        "sp.limit(f,x, 0)\n",
        "\n",
        "sp.plot(f, (x,3.99,4.01))"
      ],
      "id": "ecb3bc10",
      "execution_count": null,
      "outputs": []
    }
  ],
