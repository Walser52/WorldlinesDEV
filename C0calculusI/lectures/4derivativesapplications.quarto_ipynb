      "source": [
        "---\n",
        "title: Applications of Derivatives\n",
        "---"
      ],
      "id": "9647ae2b"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sympy as sp\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt"
      ],
      "id": "07093252",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import sympy as sp\n",
        "from sympy.plotting import plot\n",
        "\n",
        "x = sp.symbols('x')\n",
        "#Define the variable and the function\n",
        "\n",
        "f = x**(2)**(1/3) +(x+2)\n",
        "point = sp.pi / 4  # Point of tangency\n",
        "rng = [-1, 1] # Range\n",
        "\n",
        "#______________________________-\n",
        "\n",
        "slope = f.diff(x).subs(x, point)  # Calculate the slope\n",
        "tangent_line = slope * (x - point) + f.subs(x, point)\n",
        "p1 = plot(f, (x, rng[0], rng[1]), show=False, line_color='blue')\n",
        "p2 = plot(tangent_line, (x, point - 0.5, point+0.5), show=False, line_color='red', line_dash='--', label='Tangent line')\n",
        "p1.extend(p2)\n",
        "\n",
        "\n",
        "p1.show()"
      ],
      "id": "b68a7626",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Maxima/Minima"
      ],
      "id": "7a5d63a1"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "x = sp.symbols('x')\n",
        "equation = x*sp.exp(-x**2/10)\n",
        "\n",
        "firstDeriv = equation.diff(x)\n",
        "secondDeriv = firstDeriv.diff(x)\n",
        "\n",
        "criticalPoints = list(sp.solveset(firstDeriv, x))\n",
        "criticalPointsY = [equation.subs(x, a) for a in criticalPoints]\n",
        "\n",
        "xx = np.linspace(-10, 10, 1000)\n",
        "yy = sp.lambdify(x, [equation, firstDeriv, secondDeriv])(xx)\n",
        "plt.plot(xx, np.transpose(yy))\n",
        "plt.plot(criticalPoints, criticalPointsY, 'k*')\n",
        "plt.legend(['f', \"f'\", \"f''\"])\n",
        "plt.show()"
      ],
      "id": "b6b4b2a2",
      "execution_count": null,
      "outputs": []
    }
  ],
